---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Prose from "../components/Prose.astro";

type Frontmatter = CollectionEntry<"blog">["data"];
const { frontmatter, readTime } = Astro.props as {
  frontmatter: Frontmatter;
  readTime?: number;
};
---

<BaseLayout
  title={frontmatter.title}
  description={frontmatter.description}
  date={frontmatter.date}
>
  <main class="py-12 px-6 mx-auto max-w-full">
    <h1 class="mb-2 text-3xl font-semibold tracking-tight text-center">
      {frontmatter.title}
    </h1>
    {
      frontmatter.date && (
        <p class="mb-8 text-sm text-neutral-600 dark:text-neutral-400 text-center">
          <FormattedDate date={frontmatter.date} />
          {readTime && <> · {readTime} min read</>}
        </p>
      )
    }
    <Prose>
      <slot />
    </Prose>
  </main>
</BaseLayout>
