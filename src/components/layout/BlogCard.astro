---
type Props = {
  title: string
  url: string
  class?: string
  fullHeight?: boolean
}

const { title, url, class: className, fullHeight = false } = Astro.props
---

<article class:list={['py-4 border-b border-neutral-200 dark:border-neutral-800 last:border-b-0', className]}>
  <a href={url} class="group grid grid-cols-[auto_1fr] sm:grid-cols-[auto_1fr_auto] items-baseline sm:items-center gap-x-4 cursor-pointer no-underline">
    <!-- Indicator -->
    <span class="text-yellow-400 dark:text-yellow-300 transition-transform group-hover:translate-x-1">
      ▶
    </span>

    <!-- Title -->
    <h3 class="text-lg sm:text-xl font-medium text-neutral-900 dark:text-neutral-100 transition-colors group-hover:text-yellow-400 dark:group-hover:text-yellow-300">
      {title}
    </h3>

    <!-- Date (Meta) -->
    <div class="col-start-2 sm:col-start-3 text-sm text-gray-500 dark:text-gray-400 sm:text-right mt-1 sm:mt-0 opacity-70">
      <slot name="meta" />
    </div>
  </a>
</article>