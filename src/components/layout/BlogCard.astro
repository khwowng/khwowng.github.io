---
type Props = {
  title: string
  url: string
  class?: string
  fullHeight?: boolean
}

const { title, url, class: className, fullHeight = false } = Astro.props
---

<article class:list={['card', { 'card--full-height': fullHeight }, className]}>
  <a href={url} class="card-link">
    <h3 class="card-title">{title}</h3>

    <div class="card-meta">
      <slot name="meta" />
    </div>

    <div class="card-footer">
      <slot name="footer" />
    </div>
  </a>
</article>

<style>
  .card {
    border: 2px solid light-dark(hsl(0 0% 15%), hsl(0 0% 85%));
    border-radius: 0.75rem; /* slightly rounded */
    padding: 1rem 1.25rem;
    transition:
      background 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease,
      transform 0.25s ease;
  }

  .card:hover,
  .card:focus-within {
    background: light-dark(hsl(0 0% 96%), hsl(0 0% 10%));
    border-color: light-dark(hsl(170 70% 35%), hsl(170 70% 60%)); /* teal accent */
    box-shadow: 0 8px 24px -6px light-dark(hsl(170 60% 40% / 0.25), hsl(170 60% 60% / 0.25));
    transform: translateY(-2px);
  }

  .card-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .card-title {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0;
  }

  .card-meta {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    opacity: 0.7;
  }

  .card-footer {
    margin-top: 0.75rem;
    font-size: 0.875rem;
  }

  .card--full-height {
    height: 100%;
  }
</style>