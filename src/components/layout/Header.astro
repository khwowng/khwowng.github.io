---
import { SITE_TITLE } from '../../consts.ts';
import { DarkMode } from "accessible-astro-components";

const pathname = Astro.url.pathname;

const navItems = [
  { href: "/about", label: "about" },
  { href: "/blog", label: "blogs" },
  { href: "/project", label: "projects" },
];
---

<header>
  <nav class="relative flex items-center justify-between py-6">
    <!-- Left -->
    <div class="flex items-center gap-8">
      <a
        href="/"
        class="text-3xl font-bold text-yellow-400 dark:text-yellow-300 transition-colors duration-200 hover:opacity-80"
      >
        {SITE_TITLE}
      </a>
    </div>

    <!-- Center Navigation -->
    <div class="absolute left-1/2 -translate-x-1/2 hidden md:flex items-center gap-6">
      {
        navItems.map((item) => {
          const isActive =
            item.href === "/"
              ? pathname === "/"
              : pathname.startsWith(item.href);

          return (
            <a
              href={item.href}
              class={`text-lg font-bold uppercase tracking-wider transition-all duration-200 hover:underline hover:underline-offset-4 ${
                isActive
                  ? "text-yellow-400 dark:text-yellow-300"
                  : "text-neutral-600 dark:text-neutral-400 hover:text-yellow-400 dark:hover:text-yellow-300"
              }`}
            >
              {item.label}
            </a>
          );
        })
      }
    </div>




    <!-- Right -->
    <div class="flex items-center gap-4">
      <DarkMode />
    </div>
  </nav>
</header>