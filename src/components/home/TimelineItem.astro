---
type Props = {
  title: string;
  subtitle?: string;
  time?: string;
  open?: boolean;
};

const { title, subtitle, time, open = false } = Astro.props;
---

<details open={open} class="group">

  <summary class="grid sm:grid-cols-[auto_1fr_auto] items-start gap-x-4 cursor-pointer list-none">

    <!-- Toggle Indicator -->
    <span class="mt-1 text-teal-600 dark:text-teal-400 transition-transform duration-200 group-open:rotate-90">
      ▶
    </span>

    <!-- Title + Subtitle -->
  <div>
    <p class="text-l sm:text-xl font-semibold">
      {title}
    </p>

    {subtitle && (
      <p class="text-gray-600 dark:text-gray-400">
        @ {subtitle}
      </p>
    )}
  </div>

    <!-- Time -->
    {time && (
      <div class="text-sm text-gray-500 dark:text-gray-400 sm:text-right">
        {time}
      </div>
    )}

  </summary>

  <!-- Content -->
  <div class="mt-3 ml-6 text-gray-600 dark:text-gray-400">
    <slot />
  </div>

</details>