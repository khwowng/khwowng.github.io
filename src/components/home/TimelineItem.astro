---
type Props = {
  title: string;
  time?: string;
  description?: string;
};

const { title, time, description } = Astro.props;
---

<div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-2 sm:gap-6">
  <div>
    <p class="font-medium text-base sm:text-lg">{title}</p>
    {description && (
      <p class="text-gray-600 dark:text-gray-400">
        {description}
      </p>
    )}
  </div>

  {time && (
    <span class="text-sm text-gray-500 dark:text-gray-400 sm:whitespace-nowrap">
      {time}
    </span>
  )}
</div>