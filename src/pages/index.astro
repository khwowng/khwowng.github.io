---
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import BaseLayout from "../layouts/BaseLayout.astro";
const thanh = "Thanh".split("");
const ha = "Ha".split("");
const khuong = "Khuong".split("");
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="flex flex-col items-center justify-center min-h-[75vh] text-center select-none overflow-hidden">
    <h1 class="text-7xl md:text-[14rem] leading-[1.1] tracking-tighter" style="font-family: 'Bagel Fat One', system-ui;">
      <!-- Khuong - First Line -->
      <div class="block">
        {khuong.map((char) => (
          <span class="inline-block text-yellow-400 dark:text-yellow-300 drop-shadow-lg transition-transform duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)] hover:scale-125 hover:text-yellow-500 dark:hover:text-yellow-200 cursor-default relative hover:z-10">
            {char}
          </span>
        ))}
      </div>

      <!-- Thanh Ha - Second Line -->
      <div class="block mt-4">
        <span class="inline-block mr-4">
          {thanh.map((char) => (
            <span class="inline-block text-orange-400 dark:text-orange-300 drop-shadow-lg transition-transform duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)] hover:scale-125 hover:text-orange-500 dark:hover:text-orange-200 cursor-default relative hover:z-10">
              {char}
            </span>
          ))}
        </span>
        <span class="inline-block ml-4">
          {ha.map((char) => (
            <span class="inline-block text-red-400 dark:text-red-300 drop-shadow-lg transition-transform duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)] hover:scale-125 hover:text-red-500 dark:hover:text-red-200 cursor-default relative hover:z-10">
              {char}
            </span>
          ))}
        </span>
      </div>
    </h1>
	</section>
</BaseLayout>